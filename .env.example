# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# The application connects as app_user, a role that owns nothing, so row-level
# security always applies. `npm run db:migrate` uses DATABASE_URL directly and
# must therefore run as the owner (postgres) -- see README-POSTGRES.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/elev8
DATABASE_POOL_MAX=10
# Set to "true" when your server requires TLS (most managed providers do).
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Where uploaded certifications and generated application PDFs are written.
STORAGE_DIR=storage
# Signs the short-lived file links staff use. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# Without SMTP_URL, staff invitation links are printed to the server log
# instead of being emailed. Everything else works either way.
SMTP_URL=
MAIL_FROM=Elev8 Services <no-reply@withelev8.com>

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Base address used to build invitation and password-reset links.
PUBLIC_SITE_URL=http://localhost:8080
